# Telegram lead notifications (required for the contact forms)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# E-mail notifications go through Netlify Forms: /api/lead relays every lead to
# <origin>/__forms.html (see public/__forms.html) and Netlify e-mails the
# recipients configured under Forms -> Form notifications. On Netlify the origin
# is taken from DEPLOY_PRIME_URL / URL automatically; set this only to override
# it (e.g. locally, pointing at the deployed site).
NETLIFY_FORMS_ORIGIN=

# Absolute site URL used for canonical/hreflang/OG (defaults to https://quality-bm.com)
NEXT_PUBLIC_SITE_URL=https://quality-bm.com
